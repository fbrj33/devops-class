pipeline {
    agent any
    tools {
        jdk 'jdk21'
    }
    stages {
        stage('Checkout code') {
            steps {
                git branch: 'main', url: 'https://github.com/fbrj33/devops-class.git'
            }
        }
        stage('Compile code') {
            steps {
                sh 'javac Test.java'
            }
        }
        stage('Execute code') {
            steps {
                sh 'java Test'
            }
        }
    }
}
